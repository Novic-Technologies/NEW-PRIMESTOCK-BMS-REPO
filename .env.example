# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Email Delivery Service (Configure EITHER Resend OR SMTP/Gmail App Password for live automated emails)
RESEND_API_KEY=""
RESEND_FROM=""
# For Gmail SMTP, set SMTP_USER + SMTP_PASS (16-char Gmail App Password); SMTP_HOST defaults to smtp.gmail.com
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="PrimeStock BMS UG <noreply@primestockbms.ug>"
GMAIL_USER=""
GMAIL_APP_PASSWORD=""

# Optional: Meta WhatsApp Cloud API (If omitted, WhatsApp reminders use pre-filled wa.me links)
WHATSAPP_CLOUD_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Optional: Uganda Mobile Money Gateway (Flutterwave)
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_WEBHOOK_HASH=""

# Optional: Secret token for unattended scheduled Cloud Scheduler cron triggers (/api/cron/subscription-sweep)
CRON_SECRET=""

# Optional: Live URA EFRIS System-to-System Middleware API Endpoint (Leave empty to use built-in EFRIS Sandbox Fiscalizer)
EFRIS_API_URL=""
EFRIS_TIN=""
EFRIS_DEVICE_NO=""
EFRIS_PRIVATE_KEY_REF=""

